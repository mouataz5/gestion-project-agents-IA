# =============================================================================
# AI Job Application Agent — configuration template
#
# Copy to `.env` (git-ignored) and fill in values. Easiest:  make env
# (generates strong random secrets for API_AUTH_TOKEN, ENCRYPTION_KEY,
#  POSTGRES_PASSWORD and N8N_ENCRYPTION_KEY).
#
# This file must contain PLACEHOLDERS ONLY — never commit real secrets.
# Values must stay shell-compatible (the Makefile sources this file).
# =============================================================================

# --- Application --------------------------------------------------------------
APP_NAME="AI Job Application Agent"
# development | test | production  (production enforces API token, encryption key, JSON logs)
APP_ENV=development
LOG_LEVEL=INFO
# console (human readable) | json (production)
LOG_FORMAT=console
API_PREFIX=/api/v1
ENABLE_API_DOCS=true
# Comma-separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# Bearer token required by every API endpoint except /health/* (>= 32 chars in production)
API_AUTH_TOKEN=change-me-generate-with-make-env
# Used for links in notifications
PUBLIC_DASHBOARD_URL=http://localhost:3000

# --- Safety switches ------------------------------------------------------------
# true: fake jobs and mock ATS pages only, never real submissions
MOCK_MODE=true
# false: every application needs explicit approval before submission
AUTO_SUBMIT=false

# --- Database (PostgreSQL) -----------------------------------------------------------
# Used by Docker Compose to initialise the database container
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobagent
POSTGRES_PORT=5432
# Used by the application when running natively (Docker Compose overrides the host)
DATABASE_URL=postgresql+psycopg://jobagent:change-me@localhost:5432/jobagent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis / task queue --------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Optional: the broker defaults to REDIS_URL
# CELERY_BROKER_URL=redis://localhost:6379/0
# Optional: disabled by default — task outcomes are recorded as automation runs in PostgreSQL
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Paths (relative paths are resolved from the repository root) ----------------------
STORAGE_DIR=storage
CANDIDATE_DIR=candidate
PROMPTS_DIR=prompts
# Source policy (sources.yaml), watchlist seed (companies.yaml) and mock fixtures
CRAWLER_DIR=crawler
# Largest accepted CV upload (DOCX/PDF), in megabytes
MAX_UPLOAD_MB=5

# --- Security ---------------------------------------------------------------------------
# Fernet key used to encrypt secrets at rest (browser sessions, ...). Generate with: make env
ENCRYPTION_KEY=

# --- Pipeline ----------------------------------------------------------------------------
JOB_LOOKBACK_HOURS=24
# Safety cap on postings read from one source in one discovery run
DISCOVERY_MAX_JOBS_PER_SOURCE=500
# Optimisation target, not a guarantee of any employer's ATS score
ATS_TARGET_SCORE=95
ATS_MAX_ITERATIONS=3
SCHEDULER_ENABLED=true
DAILY_RUN_TIME=08:00
TIMEZONE=Africa/Tunis

# --- LLM ------------------------------------------------------------------------------
# claude | mock (offline deterministic provider). With LLM_PROVIDER=claude and no API key,
# MOCK_MODE=true falls back to the mock provider (results are labelled "mock").
LLM_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# Thinking depth and cost per answer: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# If the model declines a request, re-run it on Anthropic's recommended fallback model
LLM_REFUSAL_FALLBACK=true
# Safety cap on jobs analysed by one analysis run (each analysis is one Claude call)
ANALYSIS_MAX_JOBS_PER_RUN=25

# --- Notifications (Phase 11) ------------------------------------------------------------
# Comma-separated: email,telegram,webhook
NOTIFICATION_CHANNELS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional n8n integration: signed event webhooks
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Observability ---------------------------------------------------------------------
# logging (default). A Sentry-compatible tracker can be added later.
ERROR_TRACKER=logging

# --- Frontend (Next.js server side) -------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
# How the Next.js server reaches the API (Docker Compose sets http://backend:8000)
BACKEND_INTERNAL_URL=http://localhost:8000

# --- n8n (optional profile: make n8n) ------------------------------------------------------
N8N_PORT=5678
# Encrypts credentials stored in n8n. Keep it stable once set.
N8N_ENCRYPTION_KEY=change-me
